{
  // See https://aka.ms/vscode-remote/devcontainer.json for format details.
  // "name": "<>",
  // Use a basic core Linux image as basic template.
  // See https://containers.dev/templates for all containers(base)
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24",
  // "build": {
  //     "context": "..",
  //     "dockerfile": "Dockerfile",
  //     "args": {
  // 		"VARIANT": "3.10"
  // 	}
  // },
  // See https://containers.dev/features for all features(addons)
  "features": {
    // "ghcr.io/devcontainers/features/anaconda:1": {},
    // "ghcr.io/devcontainers/features/aws-cli:1": {},
    // "ghcr.io/devcontainers/features/azure-cli:1": {}
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true
    },
    // "ghcr.io/devcontainers/features/conda:1": {},
    // "ghcr.io/devcontainers/features/node:1": {},
    // "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    // "ghcr.io/devcontainers/features/dotnet:1": {},
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    // "ghcr.io/devcontainers/features/github-cli:1": {},
    // "ghcr.io/devcontainers/features/go:1": {},
    // "ghcr.io/dhoeric/features/google-cloud-cli:1": {},
    // "ghcr.io/devcontainers/features/hugo:1": {},
    // "ghcr.io/devcontainers/features/java:1": {},
    // "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {},
    // "ghcr.io/devcontainers/features/nix:1": {},
    // "ghcr.io/devcontainers/features/node:1": {},
    // "ghcr.io/devcontainers/features/nvidia-cuda:1": {
    //     "installCudnn": true,
    //     "installNvtx": true
    // },
    // "ghcr.io/devcontainers/features/oryx:1": {},
    // "ghcr.io/devcontainers/features/php:1": {},
    // "ghcr.io/devcontainers/features/powershell:1": {},
    // "ghcr.io/devcontainers/features/python:1": {},
    // "ghcr.io/devcontainers/features/ruby:1": {},
    // "ghcr.io/devcontainers/features/rust:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {},
    "ghcr.io/devcontainers-extra/features/tmux-apt-get:1": {}
    // "ghcr.io/devcontainers-contrib/features/zsh-plugins:0": {
    //     "plugins": "",
    //     "omzPlugins": "",
    //     "username": "vscode"
    // }
  },
  // Configure tool-specific properties.
  "customizations": {
    // Configure properties specific to VS Code.
    "vscode": {
      // Add the IDs of extensions you want installed when the container is created.
      "extensions": [
        "charliermarsh.ruff",
        // "eg2.vscode-npm-script",
        "esbenp.prettier-vscode",
        "oxc.oxc-vscode",
        // "GitHub.copilot",
        "huacnlee.autocorrect",
        "ms-playwright.playwright",
        "ms-python.python",
        "MS-vsliveshare.vsliveshare-pack",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "unifiedjs.vscode-mdx"
      ],
      // Set *default* container specific settings.json values on container create.
      "settings": {
        // "python.defaultInterpreterPath": "/usr/local/python/bin/python",
      }
    }
  },
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],
  // Use 'postCreateCommand' to run commands after the container is created.
  // mise installs pnpm, uv, and AutoCorrect; uv manages Python itself (from .python-version). Rust is opt-in (uncomment it in mise.toml).
  // The guarded echos activate mise in interactive shells so the tools are on PATH.
  "postCreateCommand": "curl https://mise.run | MISE_VERSION=v2026.7.13 sh && ~/.local/bin/mise trust && ~/.local/bin/mise run setup && { grep -qsF 'mise activate zsh' ~/.zshrc || echo 'eval \"$(~/.local/bin/mise activate zsh)\"' >> ~/.zshrc; } && { grep -qsF 'mise activate bash' ~/.bashrc || echo 'eval \"$(~/.local/bin/mise activate bash)\"' >> ~/.bashrc; }",
  // Set `remoteUser` to `root` to connect as root instead. More info: https://aka.ms/vscode-remote/containers/non-root.
  "remoteUser": "vscode"
}
